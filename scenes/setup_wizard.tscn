[node name="Loader" type="VBoxContainer" parent="Margin/Root/Pages"]
visible = false
layout_mode = 2
theme_override_constants/separation = 10
metadata/_tab_index = 2

[node name="LoaderTitle" type="Label" parent="Margin/Root/Pages/Loader"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Mod loader"

[node name="LoaderBody" type="Label" parent="Margin/Root/Pages/Loader"]
layout_mode = 2
text = "The mod loader loads zipped mods from a mods folder located next to the game exe. The mod loader will run every time you start the game and attempt to load any mods. The current game files will be backed up in case of any problems.

To uninstall the mod loader, click the \"Uninstall\" button."
autowrap_mode = 3

[node name="LoaderStatus" type="Label" parent="Margin/Root/Pages/Loader"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
text = "The mod loader is not installed."
autowrap_mode = 3

[node name="LoaderButtons" type="HBoxContainer" parent="Margin/Root/Pages/Loader"]
layout_mode = 2

[node name="InstallLoaderButton" type="Button" parent="Margin/Root/Pages/Loader/LoaderButtons"]
unique_name_in_owner = true
layout_mode = 2
text = "Install"

[node name="LoaderProgress" type="ProgressBar" parent="Margin/Root/Pages/Loader"]
unique_name_in_owner = true
visible = false
layout_mode = 2
max_value = 1.0

[node name="Finish" type="VBoxContainer" parent="Margin/Root/Pages"]
visible = false
layout_mode = 2
theme_override_constants/separation = 12
metadata/_tab_index = 3

[node name="FinishTitle" type="Label" parent="Margin/Root/Pages/Finish"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "You're set!"

[node name="FinishBody" type="Label" parent="Margin/Root/Pages/Finish"]
layout_mode = 2
size_flags_vertical = 3
text = "You successfully configured CG Mod Manager.

Add a GitHub owner/repo or a local zip, enable the mods you want, and set load order. Changes apply the next time you launch the game.

Click Finish to close this wizard. You can run it again later from Settings."
autowrap_mode = 3

