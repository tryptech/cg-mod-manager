[node name="Welcome" type="VBoxContainer" parent="Margin/Root/Pages"]
visible = false
layout_mode = 2
theme_override_constants/separation = 12
metadata/_tab_index = 0

[node name="WelcomeTitle" type="Label" parent="Margin/Root/Pages/Welcome"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Welcome to CG Mod Manager"

[node name="WelcomeBody" type="Label" parent="Margin/Root/Pages/Welcome"]
layout_mode = 2
size_flags_vertical = 3
text = "This set-up will guide you throught the basic configuration of this tool, allowing you to use GML-formatted mods for CG."
autowrap_mode = 3

[node name="Location" type="VBoxContainer" parent="Margin/Root/Pages"]
layout_mode = 2
theme_override_constants/separation = 10
metadata/_tab_index = 1

[node name="LocationTitle" type="Label" parent="Margin/Root/Pages/Location"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Game location"

[node name="LocationBody" type="Label" parent="Margin/Root/Pages/Location"]
layout_mode = 2
text = "Provide the folder that contains ChronoGear.exe."
